# Apify API token — get from https://console.apify.com
APIFY_TOKEN=your_token_here

# Wednesday/Upfluence credentials — for audience data queries
WEDNESDAY_EMAIL=it@icrush.de
WEDNESDAY_PASSWORD=your_password_here

# Optional: Anthropic API key for avatar-based gender detection
# ANTHROPIC_API_KEY=your_key_here

# Optional: skip Wednesday live queries (set to 1 when monthly quota exhausted)
# SKIP_WEDNESDAY_LIVE=0
