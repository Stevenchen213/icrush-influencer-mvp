# Apify API token — get from https://console.apify.com
APIFY_TOKEN=your_token_here

# Wednesday/Upfluence credentials — for audience data queries
WEDNESDAY_EMAIL=it@icrush.de
WEDNESDAY_PASSWORD=your_password_here

# Optional: Anthropic API key for avatar-based gender detection
# ANTHROPIC_API_KEY=your_key_here

# Optional: skip Wednesday live queries (set to 1 when monthly quota exhausted)
# SKIP_WEDNESDAY_LIVE=0

# KOL 查重 API（实习生部署的 Lambda）
# DEDUP_API_URL=https://xhyngnhrplbfhogbxzw2jz2mpm0uucmp.lambda-url.eu-central-1.on.aws/
# DEDUP_API_TOKEN=gr44g2JpuaeDUUjY5MhfyPTH68LpxS7J-CLpxPG6kn4

# Airtable exclusion (optional fallback)
# AIRTABLE_TOKEN=your_airtable_pat_here

# 飞书 exclusion (optional fallback)
# FEISHU_TOKEN=your_feishu_token_here
# FEISHU_BASE_ID=TgzJbUV0taC8VVsOyndcUp69nEh
# FEISHU_TABLE_ID=tbl0vl4DSF0ChSjg

# 飞书 results sync — 管道结果自动同步到多维表格
# 启用: FEISHU_SYNC_ENABLED=1 + FEISHU_RESULTS_BASE_ID + FEISHU_RESULTS_TABLE_ID
# FEISHU_SYNC_ENABLED=0
# FEISHU_RESULTS_BASE_ID=TgzJbUV0taC8VVsOyndcUp69nEh
# FEISHU_RESULTS_TABLE_ID=tblXXXXXXXXXXXXXX
